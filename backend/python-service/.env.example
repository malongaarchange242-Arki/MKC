# Copy this file to .env in the Python service folder and fill the real values.
# This service should never receive the production credential in the browser.

APP_NAME=FERI-AD Document Service
PYTHON_SERVICE_API_KEY=replace_with_a_secure_internal_service_key
LOG_LEVEL=INFO
TEMPLATE_DIR=templates

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
