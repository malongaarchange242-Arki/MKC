# Copy this file to .env in the backend folder and fill in the real values.
# Do not commit the actual secrets to git.

APP_ENV=development
APP_PORT=3000
LOG_LEVEL=info

# JWT
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Internal Python microservice
PYTHON_SERVICE_URL=http://localhost:8000
PYTHON_SERVICE_API_KEY=replace_with_a_very_secure_internal_api_key
PYTHON_SERVICE_TIMEOUT_MS=30000

# CORS
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://mkc-frontend.onrender.com,https://feri-mkc.com

# Email / notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
ADMIN_EMAIL=admin@example.com

# App URLs
API_BASE_URL=http://localhost:3000
ADMIN_DASHBOARD_URL=http://localhost:8080/dashboard_admin.html
BRAND_LOGO_URL=https://example.com/logo.png
